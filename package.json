{
  "name": "@quxkit/quxkit-mcp",
  "version": "0.1.0",
  "description": "One MCP server for the QuxKit family \u2014 it mounts the tools of whichever kits are installed, rather than one server per kit.",
  "type": "module",
  "main": "./dist/embed.js",
  "types": "./dist/embed.d.ts",
  "exports": {
    ".": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    }
  },
  "bin": {
    "quxkit-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.20.0",
  "license": "BUSL-1.1",
  "author": "QuxKit.AI (https://quxkit.ai)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuxKit/quxkit-mcp.git"
  },
  "homepage": "https://quxkit.ai",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "billing",
    "identity",
    "multi-tenancy",
    "email",
    "quxkit",
    "agents"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^22.10.5",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
